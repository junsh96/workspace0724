<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="BoardMapper">
	<!--  resultMap 조회된 resultMap의 결과를 특정 객체에 맵핑할 맵핑 정보를 기술하는 것 -->
	<resultMap id="boardResultMap" type="Board">
		<result column="BOARD_NO" property="boardNo"/>
		<result column="BOARD_TYPE" property="boardType"/>
		<result column="CATEGORY_NO" property="categoryNo"/>
		<result column="BOARD_TITLE" property="boardTitle"/>
		<result column="BOARD_CONTENT" property="boardContent"/>
		<result column="BOARD_WRITER" property="boardWriter"/>
		<result column="COUNT" property="count"/>
		<result column="CREATE_DATE" property="createDate"/>
		<result column="STATUS" property="status"/>
	</resultMap>
<!-- 
	select문 사용시
	<select id="식별자" resultType="결과타입" | resultMap="직접 매핑한 resultMap의 아이디">
		select * from Blog where id = #{id}
	</select>
 -->
 	<select id="selectAllBoardCount" resultType="int">
 		SELECT COUNT(*)
 		FROM BOARD
 		WHERE STATUS = 'Y'
 	</select>
 
 	<select id="selectAllBoard" resultMap="boardResultMap">
 	SELECT BOARD_NO,
			CATEGORY_NAME,
			BOARD_TITLE,
			MEMBER_ID,
			COUNT,
			TO_CHAR(CREATE_DATE, 'YYYY-MM-DD') AS CREATE_DATE
	FROM BOARD A
    JOIN CATEGORY USING(CATEGORY_NO)
    JOIN MEMBER C
    ON A.BOARD_WRITER = C.MEMBER_NO
    WHERE A.STATUS = 'Y'
    AND A.BOARD_TYPE = 1
    ORDER BY A.BOARD_NO DESC
 	</select>

</mapper>